{
  "name": "oce-ops-ui-checks",
  "private": true,
  "description": "Optional browser regression checks; the deployed application needs no build step.",
  "scripts": {
    "test": "node tests/regression.cjs",
    "screenshots": "node tests/capture.cjs",
    "test:workspaces": "node tests/workspaces.cjs",
    "test:workspace-print": "node tests/workspace-print.cjs",
    "screenshots:workspaces": "node tests/capture-workspaces.cjs",
    "verify:fast": "node tests/verify.cjs fast",
    "verify:focused": "node tests/verify.cjs focused",
    "verify:full": "node tests/verify.cjs full",
    "verify:gate": "node tests/verify.cjs gate",
    "test:verification": "node --test tests/verify.test.cjs"
  },
  "devDependencies": { "playwright": "1.62.1" }
}
