ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Synthetic OCE-OPS geometry verification fixture'),'2;1');
FILE_NAME('transformed-millimetres-ifc4.ifc','2026-10-16T00:00:00',('OCE-OPS tests'),('OCE-OPS'),'OCE-OPS synthetic fixture','OCE-OPS','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0OCEOPSGeometryTest0001',$,'Synthetic millimetre transform fixture',$,$,$,$,(#2),#10);
#2=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#3,$);
#3=IFCAXIS2PLACEMENT3D(#4,$,$);
#4=IFCCARTESIANPOINT((0.,0.,0.));
#5=IFCDIRECTION((0.,0.,1.));
#6=IFCDIRECTION((0.,1.,0.));
#7=IFCCARTESIANPOINT((0.,0.));
#8=IFCAXIS2PLACEMENT2D(#7,$);
#10=IFCUNITASSIGNMENT((#11));
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#20=IFCLOCALPLACEMENT($,#21);
#21=IFCAXIS2PLACEMENT3D(#22,#5,#6);
#22=IFCCARTESIANPOINT((10000.,20000.,3000.));
#30=IFCLOCALPLACEMENT(#20,#31);
#31=IFCAXIS2PLACEMENT3D(#32,$,$);
#32=IFCCARTESIANPOINT((2000.,1000.,500.));
#33=IFCRECTANGLEPROFILEDEF(.AREA.,'Four by two metres',#8,4000.,2000.);
#34=IFCEXTRUDEDAREASOLID(#33,#3,#5,3000.);
#35=IFCSHAPEREPRESENTATION(#2,'Body','SweptSolid',(#34));
#36=IFCPRODUCTDEFINITIONSHAPE($,$,(#35));
#37=IFCBUILDINGELEMENTPROXY('0OCEOPSGeometryTest0002',$,'Tall rotated block',$,$,#30,#36,$,.ELEMENT.);
#40=IFCLOCALPLACEMENT(#20,#41);
#41=IFCAXIS2PLACEMENT3D(#42,$,$);
#42=IFCCARTESIANPOINT((-3000.,-2000.,0.));
#43=IFCRECTANGLEPROFILEDEF(.AREA.,'One by two metres',#8,1000.,2000.);
#44=IFCEXTRUDEDAREASOLID(#43,#3,#5,1000.);
#45=IFCSHAPEREPRESENTATION(#2,'Body','SweptSolid',(#44));
#46=IFCPRODUCTDEFINITIONSHAPE($,$,(#45));
#47=IFCBUILDINGELEMENTPROXY('0OCEOPSGeometryTest0003',$,'Short rotated block',$,$,#40,#46,$,.ELEMENT.);
ENDSEC;
END-ISO-10303-21;
