#24448=IFCSHELLBASEDSURFACEMODEL((#24447));
#24449=IFCPROPERTYSINGLEVALUE('Scope',$,IFCTEXT('Local ground tie-in to the existing outer stormwater apron top edge; pit, apron, pipe, kerb and bin geometry unchanged.'),$);
#24450=IFCPROPERTYSINGLEVALUE('DrawingBasis',$,IFCTEXT('2526-10 Rev0: outer apron FS RL53.185 to53.235; inner pit lip RL53.094. CAD outline EF29F, level handles F6433-F6436.'),$);
#24451=IFCPROPERTYSINGLEVALUE('Method',$,IFCTEXT('Continuous local surface, linearly blended to the surrounding survey-derived ground within a nominal1m zone. Existing neighbouring kerb-ground boundary levels retained.'),$);
#24452=IFCPROPERTYSINGLEVALUE('Status',$,IFCTEXT('DERIVED COORDINATION GEOMETRY: local transition width and intermediate grading are not an issued earthworks design.'),$);
#24453=IFCPROPERTYSINGLEVALUE('MaximumTransitionExtent_m',$,IFCREAL(1.),$);
#24454=IFCPROPERTYSINGLEVALUE('TransitionArea_m2',$,IFCREAL(5.871587351149517),$);
